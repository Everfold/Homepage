---
import type { SceneMeta } from "../../../data/home/scenes";

interface Props {
  meta: SceneMeta;
  fullHeight?: boolean;
  hideHeader?: boolean;
  class?: string;
}

const {
  meta,
  fullHeight = false,
  hideHeader = false,
  class: className = "",
} = Astro.props;
---

<section
  id={meta.id}
  data-scene={meta.key}
  class:list={[
    "border-line/60 scroll-mt-20 border-b",
    fullHeight ? "min-h-svh" : "py-24 sm:py-32",
    className,
  ]}
>
  <div
    class:list={["mx-auto max-w-6xl px-4 sm:px-6", !hideHeader && "lg:pr-32"]}
  >
    {!hideHeader && (
      <header class="mb-10 max-w-2xl space-y-3">
        <div class="text-accent font-mono text-xs font-semibold tracking-wider uppercase">
          {meta.index} · {meta.eyebrow}
        </div>
        <h2 class="text-ink text-3xl font-bold tracking-tight sm:text-4xl">
          {meta.title}
        </h2>
        {meta.subtitle && (
          <p class="text-ink-secondary text-base leading-relaxed">
            {meta.subtitle}
          </p>
        )}
      </header>
    )}

    <slot />
  </div>
</section>
