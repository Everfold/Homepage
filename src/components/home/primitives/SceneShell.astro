---
import type { SceneMeta } from "../../../data/home/scenes";

interface Props {
  meta: SceneMeta;
  fullHeight?: boolean;
  hideHeader?: boolean;
  class?: string;
}

const {
  meta,
  fullHeight = false,
  hideHeader = false,
  class: className = "",
} = Astro.props;
---

<section
  id={meta.id}
  data-scene={meta.key}
  class:list={[
    "border-line/70 scroll-mt-20 border-b",
    fullHeight ? "min-h-svh pt-28 pb-20 sm:pt-32 sm:pb-24" : "py-24 sm:py-32",
    className,
  ]}
>
  <div class="mx-auto max-w-6xl px-4 sm:px-6 lg:pr-32">
    {!hideHeader && (
      <header class="mb-12 max-w-3xl space-y-4">
        <div class="flex flex-wrap items-center gap-2.5">
          <span class="border-accent/40 bg-accent-soft text-ink inline-flex items-center rounded-md border px-2 py-0.5 font-mono text-xs font-semibold">
            {meta.index} / {meta.eyebrow}
          </span>
          <span class="border-line bg-elevated text-ink-muted inline-flex items-center rounded-md border px-2 py-0.5 font-mono text-[11px]">
            GSAP · {meta.animationArchetype}
          </span>
        </div>
        <h2 class="text-ink text-3xl font-bold tracking-tight sm:text-4xl">
          {meta.title}
        </h2>
        <p class="text-ink-secondary text-base leading-relaxed sm:text-lg">
          {meta.subtitle}
        </p>
      </header>
    )}

    <slot />
  </div>
</section>
