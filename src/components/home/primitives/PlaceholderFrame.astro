---
interface Props {
  slotId: string;
  label: string;
  hint: string;
  aspect?: "16/9" | "16/10" | "4/3" | "auto";
  class?: string;
}

const {
  slotId,
  label,
  hint,
  aspect = "16/9",
  class: className = "",
} = Astro.props;

const aspectClass =
  aspect === "16/9"
    ? "sm:aspect-video min-h-[14rem]"
    : aspect === "16/10"
      ? "sm:aspect-[16/10] min-h-[12rem]"
      : aspect === "4/3"
        ? "sm:aspect-[4/3] min-h-[15rem]"
        : "min-h-[12rem]";
---

<figure
  data-placeholder-slot={slotId}
  class:list={[
    "border-line-strong bg-elevated/80 m-0 overflow-hidden rounded-2xl border border-dashed",
    className,
  ]}
>
  <div class="border-line bg-canvas/70 flex flex-wrap items-center justify-between gap-2 border-b px-4 py-2.5">
    <span class="text-ink-muted font-mono text-xs font-medium">
      slot://{slotId}
    </span>
    <span class="border-line bg-elevated text-ink-secondary rounded-md border px-2 py-0.5 font-mono text-[11px]">
      {label}
    </span>
  </div>

  <div
    class:list={[
      "blueprint-grid relative flex flex-col p-4 sm:p-6",
      aspectClass,
    ]}
  >
    {Astro.slots.has("default") ? (
      <slot />
    ) : (
      <div class="border-line/80 text-ink-muted flex flex-1 items-center justify-center rounded-xl border border-dashed p-6 text-center font-mono text-xs">
        PLACEHOLDER · {slotId.toUpperCase()}
      </div>
    )}
  </div>

  <figcaption class="border-line bg-canvas/60 text-ink-muted border-t px-4 py-2.5 text-xs leading-relaxed">
    {hint}
  </figcaption>
</figure>
