---
interface Props {
  slotId: string;
  label: string;
  hint?: string;
  aspect?: "16/9" | "16/10" | "4/3" | "auto";
  class?: string;
}

const {
  slotId,
  label,
  hint,
  aspect = "16/9",
  class: className = "",
} = Astro.props;

const aspectClass =
  aspect === "16/9"
    ? "sm:aspect-video min-h-[14rem]"
    : aspect === "16/10"
      ? "sm:aspect-[16/10] min-h-[11rem]"
      : aspect === "4/3"
        ? "sm:aspect-[4/3] min-h-[14rem]"
        : "min-h-[11rem]";
---

<figure
  data-placeholder-slot={slotId}
  class:list={[
    "surface-glass border-line-strong/80 m-0 overflow-hidden rounded-2xl border",
    className,
  ]}
>
  <div class="border-line/80 bg-canvas/80 flex flex-wrap items-center justify-between gap-2 border-b px-4 py-2">
    <span class="text-ink-muted font-mono text-[11px]">slot://{slotId}</span>
    <span class="text-ink-secondary font-mono text-[11px]">{label}</span>
  </div>

  <div
    class:list={[
      "blueprint-grid relative flex flex-col p-4 sm:p-5",
      aspectClass,
    ]}
  >
    {Astro.slots.has("default") ? (
      <slot />
    ) : (
      <div class="border-line/80 text-ink-muted flex flex-1 items-center justify-center rounded-xl border border-dashed p-5 text-center font-mono text-xs">
        {slotId.toUpperCase()}
      </div>
    )}
  </div>

  {hint && (
    <figcaption class="border-line/80 bg-canvas/80 text-ink-muted border-t px-4 py-2 text-xs">
      {hint}
    </figcaption>
  )}
</figure>
