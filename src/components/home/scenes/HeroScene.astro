---
import { HERO_CONTENT, getSceneMeta } from "../../../data/home/scenes";
import SceneShell from "../primitives/SceneShell.astro";

const meta = getSceneMeta("hero");
---

<SceneShell
  meta={meta}
  hideHeader
  fullHeight
  class="relative flex items-center justify-center overflow-x-clip"
>
  <div
    data-anim="hero-ambient"
    aria-hidden="true"
    class="pointer-events-none absolute inset-0"
  >
    <div class="hero-aura absolute inset-0"></div>
    <div class="blueprint-grid absolute inset-0 opacity-35 mask-[radial-gradient(ellipse_65%_55%_at_50%_45%,black,transparent)]"></div>
  </div>

  <div class="relative z-10 mx-auto max-w-3xl space-y-7 text-center">
    <div data-anim="hero-item" class="flex justify-center">
      <span class="border-accent/40 bg-accent-soft text-accent inline-flex items-center rounded-full border px-3.5 py-1 font-mono text-xs font-semibold tracking-wider">
        {HERO_CONTENT.eyebrow}
      </span>
    </div>

    <h1
      id="hero-heading"
      tabindex="-1"
      data-anim="hero-item"
      class="text-gradient-hero text-5xl font-bold tracking-tight sm:text-7xl"
    >
      {HERO_CONTENT.headline}
    </h1>

    <p
      data-anim="hero-item"
      class="text-ink-secondary mx-auto max-w-xl text-lg leading-relaxed sm:text-xl"
    >
      {HERO_CONTENT.subheadline}
    </p>

    <div
      data-anim="hero-item"
      class="flex flex-wrap items-center justify-center gap-3 pt-2"
    >
      <a
        href={HERO_CONTENT.primaryCta.href}
        class="ui-target bg-accent text-accent-ink inline-flex items-center gap-2 rounded-xl px-6 py-3 text-sm font-semibold no-underline shadow-[0_0_24px_color-mix(in_oklab,var(--accent-primary)_35%,transparent)] transition-opacity hover:opacity-90"
      >
        <span>{HERO_CONTENT.primaryCta.label}</span>
        <span aria-hidden="true">→</span>
      </a>
      <a
        href={HERO_CONTENT.secondaryCta.href}
        data-scroll-to={HERO_CONTENT.secondaryCta.href}
        class="ui-target surface-glass border-line-strong text-ink hover:border-accent inline-flex items-center rounded-xl border px-6 py-3 text-sm font-semibold no-underline transition-colors"
      >
        <span>{HERO_CONTENT.secondaryCta.label}</span>
      </a>
    </div>
  </div>

  <div
    aria-hidden="true"
    class="text-ink-muted pointer-events-none absolute bottom-7 left-1/2 -translate-x-1/2 font-mono text-[11px] tracking-[0.22em] uppercase"
  >
    Scroll ↓
  </div>
</SceneShell>
