---
import { ROADMAP_CONTENT, getSceneMeta } from "../../../data/home/scenes";
import SceneShell from "../primitives/SceneShell.astro";

const meta = getSceneMeta("roadmap");
---

<SceneShell meta={meta} class="border-b-0">
  <div class="space-y-8">
    <div class="grid gap-5 md:grid-cols-3">
      {ROADMAP_CONTENT.milestones.map((item) => (
        <article
          data-anim="roadmap-card"
          class="border-line bg-elevated space-y-3 rounded-2xl border p-5"
        >
          <div class="flex items-center justify-between gap-2">
            <span class="text-ink-muted font-mono text-xs font-semibold">
              {item.phase}
            </span>
            <span class="border-line bg-canvas text-accent rounded-full border px-2.5 py-0.5 font-mono text-[11px] font-medium">
              {item.status}
            </span>
          </div>
          <h3 class="text-ink text-lg font-semibold">{item.title}</h3>
          <p class="text-ink-secondary text-sm leading-relaxed">
            {item.summary}
          </p>
        </article>
      ))}
    </div>

    <div
      data-anim="roadmap-cta"
      class="border-line-strong bg-elevated flex flex-col gap-6 rounded-2xl border p-6 sm:p-8 lg:flex-row lg:items-center lg:justify-between"
    >
      <div class="max-w-xl space-y-2">
        <h3 class="text-ink text-2xl font-bold tracking-tight">
          {ROADMAP_CONTENT.cta.title}
        </h3>
        <p class="text-ink-secondary text-sm leading-relaxed sm:text-base">
          {ROADMAP_CONTENT.cta.description}
        </p>
      </div>

      <div class="flex flex-wrap items-center gap-3">
        <a
          href={ROADMAP_CONTENT.cta.primaryHref}
          class="ui-target bg-accent text-accent-ink inline-flex items-center gap-2 rounded-xl px-5 py-2.5 text-sm font-semibold no-underline transition-opacity hover:opacity-90"
        >
          <span>{ROADMAP_CONTENT.cta.primaryLabel}</span>
          <span aria-hidden="true">→</span>
        </a>
        <a
          href={ROADMAP_CONTENT.cta.secondaryHref}
          class="ui-target border-line-strong bg-canvas text-ink hover:border-accent inline-flex items-center rounded-xl border px-4 py-2.5 text-sm font-semibold no-underline transition-colors"
        >
          {ROADMAP_CONTENT.cta.secondaryLabel}
        </a>
        <span class="border-line bg-blueprint text-ink-muted inline-flex items-center rounded-xl border border-dashed px-4 py-2.5 font-mono text-xs">
          {ROADMAP_CONTENT.cta.waitlistPlaceholder}
        </span>
      </div>
    </div>
  </div>
</SceneShell>
