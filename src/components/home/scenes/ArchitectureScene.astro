---
import { ARCHITECTURE_CONTENT, getSceneMeta } from "../../../data/home/scenes";
import PlaceholderFrame from "../primitives/PlaceholderFrame.astro";
import SceneShell from "../primitives/SceneShell.astro";

const meta = getSceneMeta("architecture");
const { nodes } = ARCHITECTURE_CONTENT;
---

<SceneShell meta={meta}>
  <div data-anim="arch-stage" class="space-y-8">
    <PlaceholderFrame
      slotId={ARCHITECTURE_CONTENT.diagramSlot.slotId}
      label={ARCHITECTURE_CONTENT.diagramSlot.label}
      hint={ARCHITECTURE_CONTENT.diagramSlot.hint}
      aspect="16/9"
    >
      <div class="my-auto flex flex-1 items-center justify-center">
        <svg
          role="img"
          viewBox="0 0 960 400"
          class="h-auto w-full max-w-4xl overflow-visible"
        >
          <title>Agent Loop 与执行工作空间分离架构示意图</title>

          <g data-anim="arch-bridge" style="transform-origin: 480px 200px;">
            <line
              x1="310"
              y1="170"
              x2="650"
              y2="170"
              stroke="var(--accent-primary)"
              stroke-width="2"
              stroke-dasharray="6 6"
            />
            <line
              x1="310"
              y1="230"
              x2="650"
              y2="230"
              stroke="var(--border-strong)"
              stroke-width="2"
            />
            <rect
              x="365"
              y="130"
              width="230"
              height="140"
              rx="16"
              fill="var(--surface-elevated)"
              stroke="var(--accent-primary)"
              stroke-width="2"
              stroke-dasharray="5 4"
            />
            <text
              x="480"
              y="190"
              text-anchor="middle"
              fill="var(--text-primary)"
              font-size="16"
              font-weight="700"
              font-family="ui-monospace, SFMono-Regular, monospace"
            >
              {nodes.bridge.title}
            </text>
            <text
              x="480"
              y="218"
              text-anchor="middle"
              fill="var(--text-muted)"
              font-size="12"
              font-family="ui-monospace, SFMono-Regular, monospace"
            >
              {nodes.bridge.subtitle}
            </text>
          </g>

          <g data-anim="arch-loop">
            <rect
              x="60"
              y="70"
              width="270"
              height="260"
              rx="20"
              fill="var(--surface-elevated)"
              stroke="var(--border-strong)"
              stroke-width="2"
            />
            <text
              x="88"
              y="112"
              fill="var(--accent-primary)"
              font-size="12"
              font-weight="700"
              font-family="ui-monospace, SFMono-Regular, monospace"
            >
              {nodes.loop.badge}
            </text>
            <text
              x="88"
              y="156"
              fill="var(--text-primary)"
              font-size="24"
              font-weight="700"
            >
              {nodes.loop.title}
            </text>
            <text
              x="88"
              y="188"
              fill="var(--text-secondary)"
              font-size="14"
              font-family="ui-monospace, SFMono-Regular, monospace"
            >
              {nodes.loop.subtitle}
            </text>
            <rect
              x="88"
              y="224"
              width="214"
              height="74"
              rx="12"
              fill="var(--surface-blueprint)"
              stroke="var(--border-subtle)"
            />
            <text
              x="104"
              y="256"
              fill="var(--text-muted)"
              font-size="12"
              font-family="ui-monospace, SFMono-Regular, monospace"
            >
              loop_tick() -&gt; emit(action)
            </text>
            <text
              x="104"
              y="278"
              fill="var(--text-muted)"
              font-size="12"
              font-family="ui-monospace, SFMono-Regular, monospace"
            >
              await(observation_event)
            </text>
          </g>

          <g data-anim="arch-runtime">
            <rect
              x="630"
              y="70"
              width="270"
              height="260"
              rx="20"
              fill="var(--surface-elevated)"
              stroke="var(--border-strong)"
              stroke-width="2"
            />
            <text
              x="658"
              y="112"
              fill="var(--accent-primary)"
              font-size="12"
              font-weight="700"
              font-family="ui-monospace, SFMono-Regular, monospace"
            >
              {nodes.runtime.badge}
            </text>
            <text
              x="658"
              y="156"
              fill="var(--text-primary)"
              font-size="24"
              font-weight="700"
            >
              {nodes.runtime.title}
            </text>
            <text
              x="658"
              y="188"
              fill="var(--text-secondary)"
              font-size="14"
              font-family="ui-monospace, SFMono-Regular, monospace"
            >
              {nodes.runtime.subtitle}
            </text>
            <rect
              x="658"
              y="224"
              width="214"
              height="74"
              rx="12"
              fill="var(--surface-blueprint)"
              stroke="var(--border-subtle)"
            />
            <text
              x="674"
              y="256"
              fill="var(--text-muted)"
              font-size="12"
              font-family="ui-monospace, SFMono-Regular, monospace"
            >
              mount(workspace_adapter)
            </text>
            <text
              x="674"
              y="278"
              fill="var(--text-muted)"
              font-size="12"
              font-family="ui-monospace, SFMono-Regular, monospace"
            >
              exec() · snapshot() · teardown()
            </text>
          </g>
        </svg>
      </div>
    </PlaceholderFrame>

    <div class="grid gap-4 md:grid-cols-3">
      {ARCHITECTURE_CONTENT.steps.map((item) => (
        <article
          data-anim="arch-step"
          class="border-line bg-elevated space-y-2 rounded-2xl border p-5"
        >
          <div class="text-accent font-mono text-xs font-semibold">
            {item.step}
          </div>
          <h3 class="text-ink text-base font-semibold">{item.title}</h3>
          <p class="text-ink-secondary text-sm leading-relaxed">
            {item.description}
          </p>
        </article>
      ))}
    </div>
  </div>
</SceneShell>
