---
import logo from "../../../assets/logo.svg";
import { SITE_CONFIG } from "../../../data/home/site";
---

<footer class="border-line/70 bg-canvas border-t py-10">
  <div class="mx-auto flex max-w-6xl flex-col gap-5 px-4 sm:flex-row sm:items-center sm:justify-between sm:px-6">
    <div class="flex items-center gap-2.5">
      <img
        src={logo.src}
        alt=""
        width="20"
        height="20"
        decoding="async"
        class="size-5 shrink-0"
      />
      <span class="text-ink text-sm font-semibold tracking-tight">
        {SITE_CONFIG.brand}
      </span>
    </div>

    <nav aria-label="页脚链接" class="flex flex-wrap items-center gap-2">
      {SITE_CONFIG.footerLinks.map((link) => (
        <a
          href={link.href}
          data-scroll-to={link.href.startsWith("#") ? link.href : undefined}
          class="ui-target border-line bg-elevated text-ink-secondary hover:border-line-strong hover:text-ink inline-flex items-center rounded-lg border px-3 text-sm no-underline transition-colors"
        >
          {link.label}
        </a>
      ))}
    </nav>
  </div>
</footer>
