---
import { SCENES } from "../../../data/home/scenes";
---

<nav
  aria-label="页面章节"
  class="fixed top-1/2 right-5 z-30 hidden -translate-y-1/2 flex-col gap-1.5 lg:flex"
>
  {SCENES.map((scene, idx) => (
    <a
      href={`#${scene.id}`}
      data-scroll-to={`#${scene.id}`}
      data-chapter-link={scene.key}
      data-active={idx === 0 ? "true" : "false"}
      aria-current={idx === 0 ? "location" : undefined}
      class="ui-target group border-line/80 bg-elevated/80 text-ink-muted hover:border-line-strong hover:text-ink data-[active=true]:border-accent data-[active=true]:bg-accent-soft data-[active=true]:text-ink inline-flex items-center gap-2 rounded-full border px-3 text-xs font-medium no-underline backdrop-blur-md transition-colors"
    >
      <span
        aria-hidden="true"
        class="bg-ink-muted/50 group-data-[active=true]:bg-accent size-1.5 rounded-full transition-colors"
      />
      <span class="font-mono text-[11px] opacity-80">{scene.index}</span>
      <span>{scene.navLabel}</span>
    </a>
  ))}
</nav>
