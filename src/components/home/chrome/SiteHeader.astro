---
import logo from "../../../assets/logo.svg";
import { SITE_CONFIG } from "../../../data/home/site";
---

<header
  data-site-header
  data-visible="true"
  class="border-line/70 bg-canvas/75 fixed inset-x-0 top-0 z-40 border-b backdrop-blur-xl"
>
  <div class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-4 px-4 sm:px-6">
    <a
      href="#hero"
      data-scroll-to="#hero"
      class="ui-target text-ink inline-flex items-center gap-2.5 rounded-md px-2 font-semibold tracking-tight no-underline"
    >
      <img
        src={logo.src}
        alt=""
        width="24"
        height="24"
        decoding="async"
        class="size-6 shrink-0"
      />
      <span>{SITE_CONFIG.brand}</span>
    </a>

    <nav aria-label="主菜单" class="hidden items-center gap-1 md:flex">
      {SITE_CONFIG.headerNav.map((item) => (
        <a
          href={item.target}
          data-scroll-to={item.target}
          class="ui-target text-ink-secondary hover:bg-elevated hover:text-ink inline-flex items-center rounded-md px-3 text-sm font-medium no-underline transition-colors"
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="flex shrink-0 items-center">
      <a
        href={SITE_CONFIG.docsHref}
        class="ui-target bg-accent text-accent-ink inline-flex items-center gap-1.5 rounded-lg px-3.5 text-sm font-semibold no-underline transition-opacity hover:opacity-90"
      >
        <span>文档</span>
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </div>
</header>
